Dialogue: 0,0:00:05.01,0:00:12.01,Default,,0,0,0,,{\fs15\an7\fe162\b\fad(400,400)\bord1\blur5\shad\4c&H000000&\4a&HFF&\fnSweetest Cat Ever\pos(8.4,-3.734)}\N{\pos(20,-2)}{\c&HFFFF00&}{\4c&H8485E4&}SomeSub ekip arkadaşı arıyor!\N{\pos(60,63)}{\c&HFFFFFF&}Çevirmen:{\c&HFFFF00&} Patrol\N{\pos(60,111)}{\c&HFFFFFF&}Encode:{\c&HFFFF00&} Patrol\N{\pos(60,111)}{\c&HFFFFFF&}Redaktör:{\c&HFFFF00&} Patrol\N{\c&HFFFFFF&}Discord:{\c&HFFFF00&} discord.gg/somesub
Dialogue: 0,0:00:12.01,0:00:14.14,Default,,0,0,0,,{\an8}Koyun'un bilmezlikten geldiğini görünce
Dialogue: 0,0:00:14.85,0:00:16.39,Default,,0,0,0,,bir şansım olduğunu anladım.
Dialogue: 0,0:00:17.23,0:00:20.73,Default,,0,0,0,,Amamiya muhtemelen ondan hoşlanıyor.
Dialogue: 0,0:00:21.56,0:00:22.98,Default,,0,0,0,,{\an8}Muhtemelen o da Amamiya'dan.
Dialogue: 0,0:00:23.86,0:00:24.86,Default,,0,0,0,,{\an8}Ama…
Dialogue: 0,0:00:25.94,0:00:28.86,Default,,0,0,0,,{\an8}…Koyun asla\N‎ilk hamleyi yapacak biri değil.
Dialogue: 0,0:00:29.61,0:00:33.12,Default,,0,0,0,,{\an8}Muhtemelen bir sürü bahane üretip\N‎fark etmemiş gibi yapacak.
Dialogue: 0,0:00:33.74,0:00:37.75,Default,,0,0,0,,{\an8}Tek amacı incinmekten\N‎kaçınmak olan korkak biri.
Dialogue: 0,0:00:38.33,0:00:40.62,Default,,0,0,0,,Kendisi için bir şey yapmaz.
Dialogue: 0,0:00:40.62,0:00:43.88,Default,,0,0,0,,Başkalarının onu\N‎mutlu etmesine ihtiyacı var.
Dialogue: 0,0:00:43.88,0:00:46.05,Default,,0,0,0,,{\an8}Hep bekleyen, edilgen bir kız.
Dialogue: 0,0:00:49.88,0:00:51.18,Default,,0,0,0,,{\an8}Bundan nefret ederim.
Dialogue: 0,0:00:52.59,0:00:56.97,Default,,0,0,0,,{\fade(800,200)\c&H050101&\ pos(193.067,206.178)\3c&HFFFFFF&}‎BÖLÜM 15\N‎BULUTLAR VE YAĞMUR
Dialogue: 0,0:00:58.18,0:01:00.56,Default,,0,0,0,,‎Meiten grubunun konseri olacak.
Dialogue: 0,0:01:00.56,0:01:03.35,Default,,0,0,0,,‎Akahoshi ya da başka biri bahsetti mi?
Dialogue: 0,0:01:04.73,0:01:07.27,Default,,0,0,0,,Şimdi söyleyince aklıma geldi, duymuştum galiba.
Dialogue: 0,0:01:07.28,0:01:09.03,Default,,0,0,0,,‎Benimle gitmek ister misin?
Dialogue: 0,0:01:09.03,0:01:11.49,Default,,0,0,0,,‎Bir arkadaşım grupta olduğu için\N‎gitmek istiyorum.
Dialogue: 0,0:01:12.24,0:01:14.20,Default,,0,0,0,,Tek başıma gitmekten korkuyorum.
Dialogue: 0,0:01:16.12,0:01:17.41,Default,,0,0,0,,Tamam. Gidelim.
Dialogue: 0,0:01:18.62,0:01:21.91,Default,,0,0,0,,Başkalarına da haber verelim.
Dialogue: 0,0:01:21.92,0:01:23.17,Default,,0,0,0,,‎DÜŞÜŞ…
Dialogue: 0,0:01:24.33,0:01:25.96,Default,,0,0,0,,Kalabalık gitsek daha iyi olmaz mı?
Dialogue: 0,0:01:26.80,0:01:27.92,Default,,0,0,0,,‎Doğru.
Dialogue: 0,0:01:28.84,0:01:30.21,Default,,0,0,0,,‎Kusura bakma.
Dialogue: 0,0:01:30.22,0:01:32.30,Default,,0,0,0,,‎Sadece bunu soracaktım.
Dialogue: 0,0:01:32.30,0:01:35.35,Default,,0,0,0,,‎Mesaj atmaktansa ararsam\N‎daha hızlı olacağını düşündüm.
Dialogue: 0,0:01:36.97,0:01:38.39,Default,,0,0,0,,Daha hızlı, değil mi?
Dialogue: 0,0:01:39.10,0:01:42.35,Default,,0,0,0,,‎Peki, konser günü yaklaşınca\N‎tekrar haberleşiriz.
Dialogue: 0,0:01:42.35,0:01:44.44,Default,,0,0,0,,Tamam. Teşekkürler
Dialogue: 0,0:01:46.94,0:01:48.78,Default,,0,0,0,,{\an8}‎YÜKSEL\N‎YAN PLANK
Dialogue: 0,0:01:55.78,0:01:58.12,Default,,0,0,0,,Sanki hiç bitmeyecekmiş gibi yağıyor.
Dialogue: 0,0:01:59.62,0:02:02.04,Default,,0,0,0,,‎MEITEN LİSESİ
Dialogue: 0,0:02:04.92,0:02:05.92,Default,,0,0,0,,Senden hoşlanıyorum.
Dialogue: 0,0:02:08.21,0:02:13.01,Default,,0,0,0,,Bugün sınıfta Yota'yı görünce\N‎ne yapacağım?
Dialogue: 0,0:02:13.76,0:02:16.05,Default,,0,0,0,,Bir şey yokmuş gibi davranmam\N‎kalpsizlik mi olur?
Dialogue: 0,0:02:16.76,0:02:18.56,Default,,0,0,0,,Ama kaçmam daha kırıcı olmaz mı?
Dialogue: 0,0:02:19.64,0:02:22.81,Default,,0,0,0,,Bir saniye, duygularına bile\N‎karşılık veremiyorum.
Dialogue: 0,0:02:22.81,0:02:25.15,Default,,0,0,0,,Bunları düşünmem kibir değil mi?
Dialogue: 0,0:02:25.85,0:02:26.86,Default,,0,0,0,,Ne yapacağım?
Dialogue: 0,0:02:28.40,0:02:29.40,Default,,0,0,0,,‎Miki.
Dialogue: 0,0:02:31.40,0:02:32.40,Default,,0,0,0,,‎Günaydın.
Dialogue: 0,0:02:34.28,0:02:37.28,Default,,0,0,0,,‎Bugünkü Japonca sınavına çalıştın mı?
Dialogue: 0,0:02:38.87,0:02:39.95,Default,,0,0,0,,‎NE!!!
Dialogue: 0,0:02:39.95,0:02:41.41,Default,,0,0,0,,‎Bugün müydü? Mahvoldum!
Dialogue: 0,0:02:42.95,0:02:45.33,Default,,0,0,0,,‎Daha zaman var. Çalışırsın.
Dialogue: 0,0:02:45.33,0:02:46.96,Default,,0,0,0,,‎Çalışma kâğıdını ezberlemen yeter.
Dialogue: 0,0:02:46.96,0:02:48.75,Default,,0,0,0,,‎Yine aynı şeyi yapıyorsun.
Dialogue: 0,0:02:48.75,0:02:51.63,Default,,0,0,0,,‎"Ezberlemen yeter."\N‎Sanki çok kolaymış gibi!
Dialogue: 0,0:02:52.34,0:02:53.42,Default,,0,0,0,,‎Of ya!
Dialogue: 0,0:02:54.17,0:02:56.51,Default,,0,0,0,,‎İyi şanslar. Başaracaksın.
Dialogue: 0,0:02:56.51,0:02:59.72,Default,,0,0,0,,‎Yota. Biz gidiyoruz.
Dialogue: 0,0:02:59.72,0:03:00.72,Default,,0,0,0,,‎Öyle mi? Bekleyin.
Dialogue: 0,0:03:02.31,0:03:04.06,Default,,0,0,0,,‎Peki o zaman. Görüşürüz.
Dialogue: 0,0:03:18.32,0:03:20.24,Default,,0,0,0,,‎Çok iyi biri…
Dialogue: 0,0:03:27.54,0:03:28.62,Default,,0,0,0,,‎MUZLU İÇECEK
Dialogue: 0,0:03:28.63,0:03:31.13,Default,,0,0,0,,Eee Miki, bir şey olmuş belli ki
Dialogue: 0,0:03:32.63,0:03:33.67,Default,,0,0,0,,‎Bir şey olmadı.
Dialogue: 0,0:03:34.38,0:03:35.38,Default,,0,0,0,,‎Al, şunu iç.
Dialogue: 0,0:03:38.05,0:03:39.05,Default,,0,0,0,,‎DEV BİR YUDUM
Dialogue: 0,0:03:42.43,0:03:43.68,Default,,0,0,0,,‎Baksana Minato…
Dialogue: 0,0:03:45.06,0:03:48.10,Default,,0,0,0,,‎Hoşlanmadığın biriyle bile\N‎rahatlıkla çıkabiliyorsun, değil mi?
Dialogue: 0,0:03:48.73,0:03:50.73,Default,,0,0,0,,‎Ne? Bir saniye, niye laf soktun şimdi?
Dialogue: 0,0:03:51.52,0:03:54.69,Default,,0,0,0,,‎Hiç sana açılan birini reddettin mi?
Dialogue: 0,0:03:58.32,0:04:00.07,Default,,0,0,0,,‎Etmedim sanırım.
Dialogue: 0,0:04:00.07,0:04:01.24,Default,,0,0,0,,‎Neden?
Dialogue: 0,0:04:01.87,0:04:03.74,Default,,0,0,0,,‎Onunla çıkmam için bir neden yok
Dialogue: 0,0:04:04.41,0:04:06.75,Default,,0,0,0,,‎ama çıkmamam için de yok, diye düşündüm.
Dialogue: 0,0:04:06.75,0:04:07.91,Default,,0,0,0,,Onlardan nefret etmiyordum.
Dialogue: 0,0:04:09.25,0:04:10.25,Default,,0,0,0,,‎Peki sonra ne oldu?
Dialogue: 0,0:04:11.00,0:04:13.50,Default,,0,0,0,,‎Hiç pişman oldun mu?
Dialogue: 0,0:04:14.71,0:04:16.01,Default,,0,0,0,,{\an8}‎Sanırım…
Dialogue: 0,0:04:16.88,0:04:18.76,Default,,0,0,0,,‎…benimle çıktıkları için pişman oldular.
Dialogue: 0,0:04:19.43,0:04:21.09,Default,,0,0,0,,‎Hep terk edilen kişi oldum.
Dialogue: 0,0:04:21.09,0:04:24.51,Default,,0,0,0,,‎Artık bana ihtiyaç duymadıklarını\N‎ve bu konuda
Dialogue: 0,0:04:24.51,0:04:27.02,Default,,0,0,0,,‎yapabileceğim bir şey olmadığını düşündüm.
Dialogue: 0,0:04:28.48,0:04:31.10,Default,,0,0,0,,‎Acaba duygularına tam olarak
Dialogue: 0,0:04:31.10,0:04:34.07,Default,,0,0,0,,‎karşılık vermemeni mi kırıcı buldular?
Dialogue: 0,0:04:36.03,0:04:37.36,Default,,0,0,0,,‎SALDIRI ALTINDA MIYIM?
Dialogue: 0,0:04:37.36,0:04:38.78,Default,,0,0,0,,‎SUÇLULUK HİSSİ
Dialogue: 0,0:04:40.61,0:04:43.62,Default,,0,0,0,,Umarım bir gün birine âşık olursun
Dialogue: 0,0:04:44.24,0:04:46.45,Default,,0,0,0,,ve o seni hiç umursamaz.
Dialogue: 0,0:04:46.45,0:04:48.37,Default,,0,0,0,,Umarım kalbini paramparça eder.
Dialogue: 0,0:04:48.37,0:04:49.37,Default,,0,0,0,,‎GÜLÜMSE
Dialogue: 0,0:04:50.79,0:04:52.33,Default,,0,0,0,,‎Evet. Muhtemelen.
Dialogue: 0,0:04:53.50,0:04:55.88,Default,,0,0,0,,Karşılıksız aşk yaralıyormuş.
Dialogue: 0,0:04:56.50,0:04:57.55,Default,,0,0,0,,Artık bunu öğrendim.
Dialogue: 0,0:04:58.51,0:05:00.38,Default,,0,0,0,,‎Haklısın Miki.
Dialogue: 0,0:05:01.18,0:05:04.64,Default,,0,0,0,,‎Sanırım geçmişte çıktığım\N‎kızlara zarar verdim.
Dialogue: 0,0:05:05.35,0:05:07.31,Default,,0,0,0,,‎Demek sonu böyle oluyor, öyle mi?
Dialogue: 0,0:05:07.93,0:05:09.47,Default,,0,0,0,,‎Bu ilişkiler yürümüyor.
Dialogue: 0,0:05:09.48,0:05:11.94,Default,,0,0,0,,‎Bir saniye.
Dialogue: 0,0:05:11.94,0:05:16.23,Default,,0,0,0,,‎Yoksa biri sana çıkma\N‎teklif etti ve onu reddetmenin
Dialogue: 0,0:05:16.23,0:05:18.40,Default,,0,0,0,,‎doğru olup olmayacağını mı düşünüyorsun?
Dialogue: 0,0:05:20.49,0:05:22.11,Default,,0,0,0,,Hadi be.
Dialogue: 0,0:05:22.11,0:05:24.16,Default,,0,0,0,,Galiba büyük bir pot kırdım.
Dialogue: 0,0:05:24.16,0:05:25.16,Default,,0,0,0,,‎Hayır.
Dialogue: 0,0:05:26.66,0:05:27.91,Default,,0,0,0,,‎Onu reddettim zaten.
Dialogue: 0,0:05:31.46,0:05:32.46,Default,,0,0,0,,‎Ne?
Dialogue: 0,0:05:33.96,0:05:36.42,Default,,0,0,0,,‎Yani artık bu konu kapandı.
Dialogue: 0,0:05:38.84,0:05:42.30,Default,,0,0,0,,‎Bir sonuca ulaşmayacağını\N‎biliyordum zaten.
Dialogue: 0,0:05:43.01,0:05:46.64,Default,,0,0,0,,‎Ama yüreğimi açınca biraz rahatladım.
Dialogue: 0,0:05:47.56,0:05:49.64,Default,,0,0,0,,‎Öyle mi? Gerçekten mi?
Dialogue: 0,0:05:50.31,0:05:51.31,Default,,0,0,0,,‎Evet.
Dialogue: 0,0:05:52.73,0:05:56.90,Default,,0,0,0,,‎Ama bir yandan da\N‎"Vay be, gerçekten bitti" diyorum.
Dialogue: 0,0:05:57.61,0:06:00.36,Default,,0,0,0,,‎Uzun bir süredir\N‎içimde büyük bir yer kaplıyordu
Dialogue: 0,0:06:00.36,0:06:02.70,Default,,0,0,0,,‎ve gidince geride dev bir boşluk bıraktı.
Dialogue: 0,0:06:04.57,0:06:05.74,Default,,0,0,0,,‎Bir an önce…
Dialogue: 0,0:06:06.53,0:06:09.41,Default,,0,0,0,,‎…bu boşluğu doldurmak istiyorum.
Dialogue: 0,0:06:10.20,0:06:11.75,Default,,0,0,0,,‎Yota.
Dialogue: 0,0:06:11.75,0:06:13.00,Default,,0,0,0,,{\an8}Ağlamak hiç de…
Dialogue: 0,0:06:15.12,0:06:17.71,Default,,0,0,0,,Ay, ağlamıyormuş.
Dialogue: 0,0:06:18.38,0:06:22.17,Default,,0,0,0,,‎Pardon, mendile ihtiyacın\N‎olabileceğini düşünmüştüm.
Dialogue: 0,0:06:23.67,0:06:25.30,Default,,0,0,0,,‎Sağ ol. İyiyim.
Dialogue: 0,0:06:26.09,0:06:28.30,Default,,0,0,0,,‎Normalde böyle durumlarda ağlanır mı?
Dialogue: 0,0:06:29.14,0:06:31.31,Default,,0,0,0,,‎Ben ağlamayı pek beceremiyorum.
Dialogue: 0,0:06:31.93,0:06:37.31,Default,,0,0,0,,Mesela mezuniyette basketbol takımıyla\N‎finali kaybettiğimizde çok üzüldüm
Dialogue: 0,0:06:37.94,0:06:42.78,Default,,0,0,0,,ama belki de bu tür şeylere alıştım; \Nhayat böyle işte.
Dialogue: 0,0:06:43.95,0:06:46.95,Default,,0,0,0,,Ben duygularımı\N‎hep gözyaşlarıyla dışa vururum
Dialogue: 0,0:06:48.16,0:06:50.20,Default,,0,0,0,,ama Yota her şeyi içine atıyor.
Dialogue: 0,0:06:51.37,0:06:54.79,Default,,0,0,0,,‎Onu seviyorum
Dialogue: 0,0:06:54.79,0:06:56.54,Default,,0,0,0,,‎ama arkadaş olarak.
Dialogue: 0,0:06:57.92,0:07:00.42,Default,,0,0,0,,‎Onu sevgili adayı olarak görmüyor musun?
Dialogue: 0,0:07:02.67,0:07:06.72,Default,,0,0,0,,‎Ortaokulda birkaç kişiyle çıkmıştım.
Dialogue: 0,0:07:07.30,0:07:11.26,Default,,0,0,0,,Bana telefon numaralarını verdiklerinde
Dialogue: 0,0:07:11.26,0:07:13.68,Default,,0,0,0,,‎o heyecanı hissediyordum.
Dialogue: 0,0:07:13.68,0:07:14.77,Default,,0,0,0,,‎HA? BENDEN Mİ?\N‎KİMDEN?
Dialogue: 0,0:07:14.77,0:07:17.69,Default,,0,0,0,,O zaman onları\N‎sevgili adayı olarak görüyordum.
Dialogue: 0,0:07:17.69,0:07:18.77,Default,,0,0,0,,‎İYİ BİRİNE BENZİYOR
Dialogue: 0,0:07:18.77,0:07:22.82,Default,,0,0,0,,Zamanla onlardan hoşlanacağımı\N‎düşünerek çıkmaya başlıyordum, ama…
Dialogue: 0,0:07:22.82,0:07:23.90,Default,,0,0,0,,‎YİNE TERK EDİLDİM!!!
Dialogue: 0,0:07:23.90,0:07:25.49,Default,,0,0,0,,Ama hiçbiri yürümedi.
Dialogue: 0,0:07:25.49,0:07:28.61,Default,,0,0,0,,Her seferinde reddedildiğimi hissettim.
Dialogue: 0,0:07:29.20,0:07:34.37,Default,,0,0,0,,Ama sonuçta zaten onlarla ciddi bir ilişki\N‎kurmayı düşünmemiştim, yani…
Dialogue: 0,0:07:34.37,0:07:35.37,Default,,0,0,0,,‎AMAN, NEYSE\N‎UNUTTUM
Dialogue: 0,0:07:36.08,0:07:39.21,Default,,0,0,0,,‎Yani bugüne kadar hiçbir zaman\N‎gerçekten âşık olmadım.
Dialogue: 0,0:07:41.04,0:07:43.42,Default,,0,0,0,,‎Benden hoşlanmaları hoşuma gitti sadece.
Dialogue: 0,0:07:43.42,0:07:47.59,Default,,0,0,0,,O yüzden karşımdaki kişiyle aynı duyguları\N beslemeden biriyle çıkmak…
Dialogue: 0,0:07:48.26,0:07:50.93,Default,,0,0,0,,‎Bu o kişiyi kandırmak gibi olur, değil mi?
Dialogue: 0,0:07:51.93,0:07:56.48,Default,,0,0,0,,‎Yani… Öyle bir şey yaparsam\N‎kendimden nefret ederim.
Dialogue: 0,0:07:57.85,0:07:58.85,Default,,0,0,0,,‎Yani…
Dialogue: 0,0:07:59.52,0:08:01.36,Default,,0,0,0,,‎Bence kararım… Doğruydu.
Dialogue: 0,0:08:02.98,0:08:04.11,Default,,0,0,0,,‎Ama yine de…
Dialogue: 0,0:08:04.86,0:08:06.61,Default,,0,0,0,,‎…acı çekiyorum.
Dialogue: 0,0:08:11.45,0:08:15.62,Default,,0,0,0,,‎Yota'nın seni hep\N‎bir arkadaş olarak mı görmesini isterdin?
Dialogue: 0,0:08:19.21,0:08:20.29,Default,,0,0,0,,‎Bir saniye!
Dialogue: 0,0:08:20.76,0:08:22.25,Default,,0,0,0,,{\frz0.1114\pos(155.2,70.334)\c&H50CFF1&\b1\fscx63\fscy73}‎Nereden biliyorsun?
Dialogue: 0,0:08:20.29,0:08:22.25,Default,,0,0,0,,Yota, di' mi?
Dialogue: 0,0:08:22.25,0:08:23.92,Default,,0,0,0,,‎Çok açık.
Dialogue: 0,0:08:25.00,0:08:27.17,Default,,0,0,0,,‎Yani sadece…
Dialogue: 0,0:08:27.88,0:08:30.22,Default,,0,0,0,,‎Sadece ben bilmiyormuşum.
Dialogue: 0,0:08:31.22,0:08:35.60,Default,,0,0,0,,‎Ona "Seni seviyorum" ve "Arkadaş\N‎olduğumuz için çok mutluyum" dediğimde…
Dialogue: 0,0:08:37.35,0:08:38.60,Default,,0,0,0,,‎Çok aptalım… Çok kalpsizim…
Dialogue: 0,0:08:39.77,0:08:41.27,Default,,0,0,0,,‎Bu yönümden nefret ediyorum.
Dialogue: 0,0:08:46.11,0:08:47.28,Default,,0,0,0,,‎Ne yapacağım?
Dialogue: 0,0:08:48.32,0:08:49.61,Default,,0,0,0,,‎Bu büyük bir acı veriyor.
Dialogue: 0,0:08:51.57,0:08:55.70,Default,,0,0,0,,‎Yanlış bir şey yapmadın Miki.\N‎Yota'nın da suçu yok. Kimsenin yok.
Dialogue: 0,0:08:56.79,0:09:00.66,Default,,0,0,0,,‎Arkadaşın sandığın birinin
Dialogue: 0,0:09:00.67,0:09:02.38,Default,,0,0,0,,‎sana hisler beslediğini düşünsene.
Dialogue: 0,0:09:03.00,0:09:05.42,Default,,0,0,0,,‎Seni farklı gördüğünü düşünmek…
Dialogue: 0,0:09:05.96,0:09:08.26,Default,,0,0,0,,‎Biraz midem bulanırdı. Katılmıyor musun?
Dialogue: 0,0:09:08.26,0:09:09.22,Default,,0,0,0,,‎ÇAT
Dialogue: 0,0:09:09.80,0:09:11.63,Default,,0,0,0,,‎Birine âşık olmak
Dialogue: 0,0:09:11.63,0:09:13.89,Default,,0,0,0,,‎kendiliğinden olur. Fark etmezsin bile.
Dialogue: 0,0:09:14.60,0:09:18.18,Default,,0,0,0,,‎Karşılık almasan bile.
Dialogue: 0,0:09:18.18,0:09:19.27,Default,,0,0,0,,Ama dahası…
Dialogue: 0,0:09:19.27,0:09:25.19,Default,,0,0,0,,Koyun, arkadaşlarını asla potansiyel\N‎sevgili olarak görmeyeceğini söyledi.
Dialogue: 0,0:09:27.78,0:09:30.57,Default,,0,0,0,,‎Kalbinin kırılabileceğini bilirsin.
Dialogue: 0,0:09:31.99,0:09:35.53,Default,,0,0,0,,Kimi ikna etmeye çalışıyorum?
Dialogue: 0,0:09:36.95,0:09:37.95,Default,,0,0,0,,Ben…
Dialogue: 0,0:09:39.20,0:09:40.83,Default,,0,0,0,,Bu duygularım…
Dialogue: 0,0:09:43.79,0:09:46.13,Default,,0,0,0,,‎Of, çok açım.
Dialogue: 0,0:09:46.13,0:09:47.29,Default,,0,0,0,,‎Abilerim!
Dialogue: 0,0:09:47.30,0:09:48.50,Default,,0,0,0,,‎Merhabalar.
Dialogue: 0,0:09:48.50,0:09:49.59,Default,,0,0,0,,‎TEZAHÜRAT GRUPLARI
Dialogue: 0,0:09:49.59,0:09:50.72,Default,,0,0,0,,‎Merhaba Kuriki.
Dialogue: 0,0:09:51.38,0:09:54.38,Default,,0,0,0,,‎Yaklaşan konsere geleceğim.\N‎Heyecanla bekliyorum.
Dialogue: 0,0:09:54.39,0:09:55.60,Default,,0,0,0,,‎Ya, öyle mi?
Dialogue: 0,0:09:56.22,0:09:58.51,Default,,0,0,0,,‎Evet! Amamiya'yla.
Dialogue: 0,0:09:59.31,0:10:00.60,Default,,0,0,0,,‎BAK SEN…
Dialogue: 0,0:10:00.60,0:10:02.77,Default,,0,0,0,,‎İkiniz sevgili misiniz?
Dialogue: 0,0:10:03.31,0:10:04.73,Default,,0,0,0,,‎Öyle bir şey değil.
Dialogue: 0,0:10:04.73,0:10:07.27,Default,,0,0,0,,‎Başkalarını da çağırmaya karar verdik.
Dialogue: 0,0:10:07.98,0:10:11.40,Default,,0,0,0,,‎Ama ben çok ısrarcı olduğum için\N‎kesin atlatmaya çalışacak.
Dialogue: 0,0:10:11.40,0:10:12.99,Default,,0,0,0,,{\an8}‎NASIL YANİ?\N‎ATLATMAK MI?
Dialogue: 0,0:10:12.99,0:10:14.11,Default,,0,0,0,,‎Görüşürüz!
Dialogue: 0,0:10:17.03,0:10:20.16,Default,,0,0,0,,‎Amamiya onu atlatıyor mu?\N‎Yoksa Kuriki kafasında mı kuruyor?
Dialogue: 0,0:10:20.16,0:10:21.54,Default,,0,0,0,,‎Herhâlde.
Dialogue: 0,0:10:21.54,0:10:24.29,Default,,0,0,0,,‎Her durumda,\N‎korkarım kızcağızın kalbi kırılacak.
Dialogue: 0,0:10:26.71,0:10:28.38,Default,,0,0,0,,‎SINIF 2 ŞUBE 2
Dialogue: 0,0:10:28.88,0:10:29.88,Default,,0,0,0,,‎Miki.
Dialogue: 0,0:10:30.59,0:10:32.01,Default,,0,0,0,,‎Bugün işe gidecek misin?
Dialogue: 0,0:10:32.01,0:10:33.42,Default,,0,0,0,,‎Ne? Hayır.
Dialogue: 0,0:10:34.26,0:10:36.64,Default,,0,0,0,,‎Okuldan sonra\N‎bir yerde oturup konuşalım mı?
Dialogue: 0,0:10:36.64,0:10:37.64,Default,,0,0,0,,‎Tabii.
Dialogue: 0,0:10:38.64,0:10:40.68,Default,,0,0,0,,Koyun normalde beni bir yerlere çağırmaz.
Dialogue: 0,0:10:41.72,0:10:43.64,Default,,0,0,0,,Ona soracağım çok şey var.
Dialogue: 0,0:10:43.64,0:10:45.35,Default,,0,0,0,,‎İYİ MİSİN?\N‎KONUŞMAK İSTER MİSİN?
Dialogue: 0,0:10:45.35,0:10:46.90,Default,,0,0,0,,Ama ona anlatmadıklarım da var.
Dialogue: 0,0:10:46.90,0:10:48.15,Default,,0,0,0,,‎YOTA HAKKINDA\N‎AMAMIYA HAKKINDA
Dialogue: 0,0:10:48.69,0:10:50.27,Default,,0,0,0,,Amamiya konusunda…
Dialogue: 0,0:10:50.27,0:10:51.36,Default,,0,0,0,,‎UTANIYORUM
Dialogue: 0,0:10:51.36,0:10:53.74,Default,,0,0,0,,Ama bunca zaman sonra\N‎bunu söylemeye utanıyorum.
Dialogue: 0,0:10:53.74,0:10:54.82,Default,,0,0,0,,‎İÇİMİ DÖKMELİYİM
Dialogue: 0,0:10:54.82,0:10:56.91,Default,,0,0,0,,Bunu kendime bile itiraf etmemiştim.
Dialogue: 0,0:10:56.91,0:10:57.91,Default,,0,0,0,,‎YA RAHATSIZ OLURSA?
Dialogue: 0,0:10:58.45,0:11:02.16,Default,,0,0,0,,Kafamın içinde dönüp duran\N‎çok fazla düşünce var.
Dialogue: 0,0:11:02.16,0:11:03.91,Default,,0,0,0,,Bunları açığa vurmaktan korkuyorum.
Dialogue: 0,0:11:03.91,0:11:07.00,Default,,0,0,0,,Ciddi bir konuşma mı olacak?
Dialogue: 0,0:11:07.00,0:11:09.08,Default,,0,0,0,,Tavsiye mi isteyecek? Ne yapacağım?
Dialogue: 0,0:11:09.09,0:11:11.46,Default,,0,0,0,,Aslında ben Yota'yı…
Dialogue: 0,0:11:11.46,0:11:14.42,Default,,0,0,0,,Konu buysa ne yapacağım\N‎ve olanların ne kadarını söyleyeceğim?
Dialogue: 0,0:11:17.18,0:11:18.18,Default,,0,0,0,,‎Yota?
Dialogue: 0,0:11:18.89,0:11:21.43,Default,,0,0,0,,‎Eve giderken bir yere uğrayıp\N‎bir şeyler yiyelim mi?
Dialogue: 0,0:11:24.52,0:11:27.52,Default,,0,0,0,,‎Tabii. Benimle her şeyi konuşabilirsin.
Dialogue: 0,0:11:28.94,0:11:31.57,Default,,0,0,0,,‎Öyle bir şey kastetmemiştim.
Dialogue: 0,0:11:35.15,0:11:36.24,Default,,0,0,0,,‎YUMUŞAK
Dialogue: 0,0:11:36.24,0:11:37.78,Default,,0,0,0,,‎En lezzetlileri bunlar.
Dialogue: 0,0:11:37.78,0:11:38.82,Default,,0,0,0,,‎Miki.
Dialogue: 0,0:11:39.66,0:11:43.83,Default,,0,0,0,,‎Bak, sana bir şey anlatmak zorundayım.
Dialogue: 0,0:11:45.96,0:11:47.79,Default,,0,0,0,,‎Şey… Ben…
Dialogue: 0,0:11:47.79,0:11:49.71,Default,,0,0,0,,‎-Amamiya'ya…\N‎-Çok zaman oldu, değil mi?
Dialogue: 0,0:11:50.54,0:11:53.46,Default,,0,0,0,,‎Seni çağırıyorum\N‎ama beni hep reddediyorsun Yota.
Dialogue: 0,0:11:54.30,0:11:55.84,Default,,0,0,0,,‎Bu, doğru değil.
Dialogue: 0,0:11:56.55,0:11:58.30,Default,,0,0,0,,‎Ne? Yanımızdaki masada onlar mı var?
Dialogue: 0,0:11:58.84,0:12:00.93,Default,,0,0,0,,‎Evet, kesinlikle onlar.
Dialogue: 0,0:12:00.93,0:12:03.35,Default,,0,0,0,,‎Bundan emin misin? Neyse, peki.
Dialogue: 0,0:12:04.14,0:12:05.31,Default,,0,0,0,,-Yota!\N‎-Amamiya!
Dialogue: 0,0:12:05.31,0:12:07.73,Default,,0,0,0,,‎Baksana Minato.
Dialogue: 0,0:12:07.73,0:12:08.73,Default,,0,0,0,,‎Evet?
Dialogue: 0,0:12:09.40,0:12:11.36,Default,,0,0,0,,‎Kurita'yla çıkacak mısın?
Dialogue: 0,0:12:16.24,0:12:17.36,Default,,0,0,0,,‎Baksana Minato.
Dialogue: 0,0:12:19.32,0:12:21.41,Default,,0,0,0,,‎Kurita'yla çıkacak mısın?
Dialogue: 0,0:12:22.32,0:12:23.62,Default,,0,0,0,,Kurita mı?
Dialogue: 0,0:12:23.62,0:12:25.04,Default,,0,0,0,,-O da kim?\N‎-O da kim?
Dialogue: 0,0:12:25.79,0:12:27.00,Default,,0,0,0,,‎Kuriki mi demek istedin?
Dialogue: 0,0:12:27.66,0:12:30.71,Default,,0,0,0,,‎Ha, evet. Birinci sınıftaki kız.
Dialogue: 0,0:12:31.46,0:12:34.13,Default,,0,0,0,,‎Niye böyle bir soru sordun?
Dialogue: 0,0:12:34.13,0:12:36.38,Default,,0,0,0,,‎Çünkü beraber konsere gidecekmişsiniz.
Dialogue: 0,0:12:37.17,0:12:38.80,Default,,0,0,0,,‎Alt tarafı bir konser.
Dialogue: 0,0:12:39.43,0:12:41.80,Default,,0,0,0,,‎Ayrıca başkalarını da çağıracağım.
Dialogue: 0,0:12:41.80,0:12:42.80,Default,,0,0,0,,‎Sen gelir misin?
Dialogue: 0,0:12:43.76,0:12:45.10,Default,,0,0,0,,‎Bak.
Dialogue: 0,0:12:45.10,0:12:47.43,Default,,0,0,0,,‎Ortaokuldan beri
Dialogue: 0,0:12:47.43,0:12:49.81,Default,,0,0,0,,‎pek çok kızla "arkadaşlık" ediyorsun.
Dialogue: 0,0:12:49.81,0:12:51.90,Default,,0,0,0,,‎Bu şekilde onlara umut veriyorsun.
Dialogue: 0,0:12:52.40,0:12:55.19,Default,,0,0,0,,‎Bu konuşmayı dinlememiz doğru mu?
Dialogue: 0,0:12:55.19,0:12:57.15,Default,,0,0,0,,‎Artık hiçbir şey yapamayız.
Dialogue: 0,0:12:57.82,0:13:01.57,Default,,0,0,0,,‎Bu şekilde kaç kızla\N‎çıkmaya başlayıp sonra ayrıldın?
Dialogue: 0,0:13:03.57,0:13:08.12,Default,,0,0,0,,Yota'nın ilk kez içini dökmek için\N‎bana geldiğini sanmıştım.
Dialogue: 0,0:13:08.12,0:13:11.12,Default,,0,0,0,,Ama bana saldırıyor.\N‎Tıpkı Miki'nin yaptığı gibi…
Dialogue: 0,0:13:11.75,0:13:17.92,Default,,0,0,0,,‎Yani ilgilenmediğim herkesi\N‎hemen reddetmeli miyim?
Dialogue: 0,0:13:18.59,0:13:22.05,Default,,0,0,0,,‎Nefret etmediğin birini\N‎hemen reddetmek gerçekten daha mı iyi?
Dialogue: 0,0:13:22.97,0:13:26.14,Default,,0,0,0,,‎Hemen reddet demiyorum, ama…
Dialogue: 0,0:13:26.14,0:13:28.60,Default,,0,0,0,,‎Ama kimseye boş ümitler vermemelisin.
Dialogue: 0,0:13:29.68,0:13:33.27,Default,,0,0,0,,‎Biri sana boş ümitler verdiği için mi\N‎bunu söylüyorsun?
Dialogue: 0,0:13:33.27,0:13:34.94,Default,,0,0,0,,‎Bunun Miki'yle hiçbir ilgisi yok!
Dialogue: 0,0:13:41.11,0:13:42.20,Default,,0,0,0,,‎Özür dilerim.
Dialogue: 0,0:13:42.20,0:13:43.32,Default,,0,0,0,,‎Ben de.
Dialogue: 0,0:13:44.11,0:13:45.45,Default,,0,0,0,,Bam teline bastım…
Dialogue: 0,0:13:46.08,0:13:47.16,Default,,0,0,0,,‎GÖZLER DOLU DOLU
Dialogue: 0,0:13:47.16,0:13:48.54,Default,,0,0,0,,Yota…
Dialogue: 0,0:13:48.54,0:13:51.75,Default,,0,0,0,,Eyvah… Henüz Koyun'a\N‎bundan bahsetmemiştim…
Dialogue: 0,0:13:52.29,0:13:54.75,Default,,0,0,0,,‎Ne kadarını biliyorsun?
Dialogue: 0,0:13:55.33,0:13:57.13,Default,,0,0,0,,‎Üzgünüm. Her şeyi biliyorum.
Dialogue: 0,0:13:59.59,0:14:01.97,Default,,0,0,0,,‎Seni zor bir duruma\N‎soktuğum için özür dilerim.
Dialogue: 0,0:14:01.97,0:14:03.84,Default,,0,0,0,,‎Hayır, sorun değil.
Dialogue: 0,0:14:04.47,0:14:05.80,Default,,0,0,0,,‎Minato.
Dialogue: 0,0:14:07.43,0:14:08.93,Default,,0,0,0,,‎Hiç âşık oldun mu?
Dialogue: 0,0:14:09.81,0:14:11.48,Default,,0,0,0,,‎Âşık mı?
Dialogue: 0,0:14:12.06,0:14:16.48,Default,,0,0,0,,‎Evet. Yani hiç "Kimse onun yerine geçemez,\N‎benim için doğru kişi o" dedin mi?
Dialogue: 0,0:14:17.82,0:14:18.86,Default,,0,0,0,,‎Bunu…
Dialogue: 0,0:14:19.48,0:14:21.24,Default,,0,0,0,,‎Herkes için hissediyorum.
Dialogue: 0,0:14:23.45,0:14:25.86,Default,,0,0,0,,‎Senin için de, Miki için de\N‎böyle hissediyorum.
Dialogue: 0,0:14:25.87,0:14:27.95,Default,,0,0,0,,‎Benim için ikinizin de\N‎yerine kimse geçemez.
Dialogue: 0,0:14:28.66,0:14:29.74,Default,,0,0,0,,‎Peki ya Koyun?
Dialogue: 0,0:14:32.79,0:14:34.96,Default,,0,0,0,,‎Koyun harika biri, değil mi?
Dialogue: 0,0:14:34.96,0:14:36.04,Default,,0,0,0,,‎GÜM GÜM
Dialogue: 0,0:14:36.04,0:14:39.38,Default,,0,0,0,,‎Hep beraberiz\N‎ve onunla iyi anlaşıyorsun, değil mi?
Dialogue: 0,0:14:40.55,0:14:43.22,Default,,0,0,0,,‎Ona karşı özel duyguların var mı?
Dialogue: 0,0:14:44.68,0:14:45.89,Default,,0,0,0,,‎Koyun…
Dialogue: 0,0:14:48.01,0:14:49.01,Default,,0,0,0,,‎Onu seviyorum.
Dialogue: 0,0:14:50.51,0:14:51.56,Default,,0,0,0,,‎O benim arkadaşım.
Dialogue: 0,0:14:53.14,0:14:54.64,Default,,0,0,0,,‎Yani onu seviyorum.
Dialogue: 0,0:14:57.44,0:14:58.65,Default,,0,0,0,,‎Anladım.
Dialogue: 0,0:14:59.44,0:15:02.90,Default,,0,0,0,,‎Bir gün âşık olduğunu görmeyi çok isterim.
Dialogue: 0,0:15:05.20,0:15:06.28,Default,,0,0,0,,‎Yani kim bilebilir?
Dialogue: 0,0:15:07.45,0:15:09.12,Default,,0,0,0,,‎Bunu sana nasıl göstereceğim?
Dialogue: 0,0:15:14.71,0:15:16.54,Default,,0,0,0,,‎Yağmur mevsimi çok kötü. Her yer ıslak.
Dialogue: 0,0:15:18.29,0:15:19.54,Default,,0,0,0,,‎Koyun.
Dialogue: 0,0:15:21.50,0:15:24.30,Default,,0,0,0,,‎Üzgünüm Miki. Ben…
Dialogue: 0,0:15:25.05,0:15:26.55,Default,,0,0,0,,‎Ona âşık oldum.
Dialogue: 0,0:15:27.64,0:15:29.01,Default,,0,0,0,,‎Yota'ya…
Dialogue: 0,0:15:29.01,0:15:30.43,Default,,0,0,0,,‎Amamiya'yı seviyorum.
Dialogue: 0,0:15:33.02,0:15:36.27,Default,,0,0,0,,‎Bir saniye, ne? Bekle.
Dialogue: 0,0:15:36.27,0:15:38.15,Default,,0,0,0,,{\an8}‎Daha önce söylemediğim için üzgünüm.
Dialogue: 0,0:15:39.15,0:15:41.44,Default,,0,0,0,,{\an8}‎Duygularımdan emin değildim.
Dialogue: 0,0:15:42.19,0:15:44.90,Default,,0,0,0,,{\an8}‎Ne istediğimi bile bilmediğim için
Dialogue: 0,0:15:44.90,0:15:45.99,Default,,0,0,0,,‎sana söyleyemedim.
Dialogue: 0,0:15:45.99,0:15:47.07,Default,,0,0,0,,‎BEKLE\N‎YAPAMAM
Dialogue: 0,0:15:47.07,0:15:48.28,Default,,0,0,0,,Bekle… Bunu yapamam…
Dialogue: 0,0:15:48.28,0:15:51.28,Default,,0,0,0,,Yani bunca zamandır…
Dialogue: 0,0:15:51.28,0:15:53.74,Default,,0,0,0,,‎Koyun'u böyle kandırmaya çalışma.
Dialogue: 0,0:15:54.45,0:15:57.33,Default,,0,0,0,,‎Aralarını yapacağım.
Dialogue: 0,0:15:57.33,0:15:58.41,Default,,0,0,0,,‎KELİME BULAMIYOR
Dialogue: 0,0:15:58.42,0:16:01.13,Default,,0,0,0,,Eyvah… Bunu yapamam…\N‎Eyvah, çok kötü, berbat bir durum!
Dialogue: 0,0:16:02.54,0:16:03.88,Default,,0,0,0,,‎Kusacağım galiba.
Dialogue: 0,0:16:06.09,0:16:07.38,Default,,0,0,0,,‎Miki…
Dialogue: 0,0:16:08.09,0:16:11.51,Default,,0,0,0,,‎Açıkçası sonuçta ne olmasını\N‎istediğimi bile düşünmedim.
Dialogue: 0,0:16:11.51,0:16:14.35,Default,,0,0,0,,‎Ve Amamiya sadece arkadaş\N‎olduğumuzu söyledi. Yani…
Dialogue: 0,0:16:15.35,0:16:19.02,Default,,0,0,0,,‎Hayır! Kusacağım derken\N‎kendimden bahsediyordum.
Dialogue: 0,0:16:20.15,0:16:21.40,Default,,0,0,0,,‎Benim kafamda hep
Dialogue: 0,0:16:22.06,0:16:23.52,Default,,0,0,0,,böyle bir şey vardı!
Dialogue: 0,0:16:25.23,0:16:26.49,Default,,0,0,0,,Ama ben…
Dialogue: 0,0:16:27.11,0:16:30.11,Default,,0,0,0,,‎Ama ben… O zaman senin…
Dialogue: 0,0:16:30.11,0:16:33.03,Default,,0,0,0,,‎Ama ben…
Dialogue: 0,0:16:34.33,0:16:36.08,Default,,0,0,0,,{\an8}‎YANLIŞ ANLAMA KALMADI
Dialogue: 0,0:16:36.08,0:16:40.83,Default,,0,0,0,,‎Yani bunca zamandır\N‎Yota'nın aşkına engel mi olmuşum?
Dialogue: 0,0:16:40.83,0:16:42.13,Default,,0,0,0,,‎Hiç ilgisi yok!
Dialogue: 0,0:16:42.79,0:16:46.17,Default,,0,0,0,,‎Her durumda Yota'yı\N‎hep sadece arkadaş olarak gördüm.
Dialogue: 0,0:16:47.21,0:16:48.38,Default,,0,0,0,,Miki.
Dialogue: 0,0:16:48.38,0:16:53.97,Default,,0,0,0,,{\an8}Aşk için "pastanın üstündeki kiraz"\N‎demiştin, hatırlıyor musun?
Dialogue: 0,0:16:53.97,0:16:56.60,Default,,0,0,0,,{\an8}‎Bu kirazın Yota olmasını istemez misin?
Dialogue: 0,0:16:58.39,0:16:59.39,Default,,0,0,0,,‎Farz edelim ki
Dialogue: 0,0:17:00.14,0:17:05.11,Default,,0,0,0,,‎bir gün sana geliyorum ve bunca zamandır\N‎sana özel duygular beslediğimi söylüyorum.
Dialogue: 0,0:17:05.11,0:17:09.53,Default,,0,0,0,,‎"Tamam, ben de sana karşı aynısını\N‎hissetmeye başladım" mı dersin?
Dialogue: 0,0:17:10.32,0:17:11.41,Default,,0,0,0,,‎Bu…
Dialogue: 0,0:17:11.99,0:17:15.08,Default,,0,0,0,,‎Bu o kadar kolay olmazdı sanırım.
Dialogue: 0,0:17:16.29,0:17:19.79,Default,,0,0,0,,‎Çıkma teklifi bende\N‎mutluluktan çok mutsuzluk yarattı.
Dialogue: 0,0:17:19.79,0:17:22.08,Default,,0,0,0,,‎Ama bir yandan da bana âşık olan birine
Dialogue: 0,0:17:22.08,0:17:25.59,Default,,0,0,0,,‎âşık olmanın daha kolay\N‎olduğunu düşünüyorum.
Dialogue: 0,0:17:26.17,0:17:29.55,Default,,0,0,0,,‎İsteksiz bir şekilde evet demenin\N‎ona zarar vereceğini düşündüğüm için
Dialogue: 0,0:17:29.55,0:17:30.63,Default,,0,0,0,,‎hayır dedim.
Dialogue: 0,0:17:30.63,0:17:33.18,Default,,0,0,0,,‎Ama yine de acı veriyor.
Dialogue: 0,0:17:33.97,0:17:36.43,Default,,0,0,0,,‎Peki ne yapmam gerekirdi?
Dialogue: 0,0:17:38.35,0:17:39.52,Default,,0,0,0,,‎Miki. Dinle.
Dialogue: 0,0:17:40.35,0:17:42.31,Default,,0,0,0,,‎Yota'nın sana karşı ilgisi…
Dialogue: 0,0:17:43.94,0:17:45.02,Default,,0,0,0,,...cinsel bir şey değil.
Dialogue: 0,0:17:45.52,0:17:47.02,Default,,0,0,0,,{\pos(283.2,57.533)}CİNSEL
Dialogue: 0,0:17:47.02,0:17:52.32,Default,,0,0,0,,‎Güzel ya da seksi olduğun için\N‎seninle birlikte olmak istemiyor.
Dialogue: 0,0:17:52.32,0:17:53.40,Default,,0,0,0,,‎Koyun!
Dialogue: 0,0:17:53.41,0:17:56.87,Default,,0,0,0,,‎Yota da seni bir arkadaş olarak seviyor.
Dialogue: 0,0:17:57.99,0:18:01.62,Default,,0,0,0,,Seni gerçekte olduğun gibi görüyor.
Dialogue: 0,0:18:02.12,0:18:07.04,Default,,0,0,0,,Hep seni mutlu etmenin\N‎yollarını düşünüyor.
Dialogue: 0,0:18:07.75,0:18:10.38,Default,,0,0,0,,‎Senin onun ihtiyaçlarını\N‎karşılamanı beklemiyor.
Dialogue: 0,0:18:11.05,0:18:12.55,Default,,0,0,0,,‎Öyle biri değil.
Dialogue: 0,0:18:13.18,0:18:14.18,Default,,0,0,0,,‎Dolayısıyla
Dialogue: 0,0:18:15.01,0:18:18.26,Default,,0,0,0,,‎onunla yaşadıkların için\N‎kendini bu kadar suçlama.
Dialogue: 0,0:18:20.10,0:18:23.27,Default,,0,0,0,,{\an8}‎Bana göre… Sen sadece Miki'sin.
Dialogue: 0,0:18:28.98,0:18:30.73,Default,,0,0,0,,‎Bugün ben…
Dialogue: 0,0:18:31.61,0:18:34.36,Default,,0,0,0,,‎Yota bugün sırama geldi
Dialogue: 0,0:18:35.11,0:18:36.78,Default,,0,0,0,,‎ama ben gözlerimi kaçırdım.
Dialogue: 0,0:18:39.08,0:18:41.70,Default,,0,0,0,,‎Yarın daha normal davranmaya çalışacağım.
Dialogue: 0,0:18:43.21,0:18:44.21,Default,,0,0,0,,‎Merak etme.
Dialogue: 0,0:18:48.38,0:18:50.88,Default,,0,0,0,,‎TAKA TUKA
Dialogue: 0,0:18:50.88,0:18:52.84,Default,,0,0,0,,{\an8}‎AĞLAMAKTAN ŞİŞEN GÖZLER
Dialogue: 0,0:18:52.84,0:18:55.05,Default,,0,0,0,,{\an8}‎Peki ne yapacaksın?
Dialogue: 0,0:18:55.05,0:18:56.63,Default,,0,0,0,,{\an8}‎Ne? Ne demek istiyorsun?
Dialogue: 0,0:18:56.64,0:18:59.35,Default,,0,0,0,,‎Minato'ya duygularını açacak mısın?
Dialogue: 0,0:18:59.35,0:19:01.18,Default,,0,0,0,,‎Hayır, açmayacağım.
Dialogue: 0,0:19:02.39,0:19:07.52,Default,,0,0,0,,‎Bana ilk kez bundan bahsettin\N‎ve arkadaşın olarak
Dialogue: 0,0:19:07.52,0:19:09.57,Default,,0,0,0,,‎sana destek olmak isterim.
Dialogue: 0,0:19:10.98,0:19:12.40,Default,,0,0,0,,‎Sağ ol.
Dialogue: 0,0:19:12.40,0:19:15.28,Default,,0,0,0,,‎Ama artık beni sadece arkadaş olarak\N‎gördüğünü biliyorum.
Dialogue: 0,0:19:16.03,0:19:18.57,Default,,0,0,0,,‎Çok geç olmadan\N‎eski duygularıma dönmeliyim.
Dialogue: 0,0:19:19.32,0:19:22.83,Default,,0,0,0,,{\an8}‎Zaten Amamiya arkadaş olarak\N‎çok eğlenceli biri değil mi?
Dialogue: 0,0:19:23.50,0:19:27.37,Default,,0,0,0,,{\an8}‎Zaten flört işlerinden anlamadığım için\N‎kalbini kazanmam zor olurdu.
Dialogue: 0,0:19:29.08,0:19:30.59,Default,,0,0,0,,{\pos(142.8,151.4)}‎BUNU REDDEDEMEM
Dialogue: 0,0:19:32.38,0:19:34.34,Default,,0,0,0,,‎Arkadaş olarak takılmaya devam edelim.
Dialogue: 0,0:19:35.92,0:19:36.93,Default,,0,0,0,,‎Evet.
Dialogue: 0,0:19:42.10,0:19:46.73,Default,,0,0,0,,Nefret etmediğin birini\N‎hemen reddetmek gerçekten daha mı iyi?
Dialogue: 0,0:19:46.73,0:19:51.02,Default,,0,0,0,,Amamiya mizacı gereği herkese karşı
Dialogue: 0,0:19:51.02,0:19:52.73,Default,,0,0,0,,çok nazik ve sevecen.
Dialogue: 0,0:19:52.73,0:19:55.11,Default,,0,0,0,,Ben bana özel bir şey sandım
Dialogue: 0,0:19:55.65,0:19:57.40,Default,,0,0,0,,ve olmadık duygulara kapıldım.
Dialogue: 0,0:19:57.40,0:19:58.41,Default,,0,0,0,,Ben…
Dialogue: 0,0:19:59.95,0:20:02.45,Default,,0,0,0,,Büyük bir aptallık ettim.
Dialogue: 0,0:20:19.93,0:20:20.93,Default,,0,0,0,,Sorun yok.
Dialogue: 0,0:20:27.18,0:20:30.23,Default,,0,0,0,,Henüz çok geç değil.
Dialogue: 0,0:20:33.11,0:20:34.44,Default,,0,0,0,,Unutabilirim.
Dialogue: 0,0:20:35.36,0:20:38.49,Default,,0,0,0,,Onunla sevgili olmak için arkadaş olmadım.
Dialogue: 0,0:20:39.61,0:20:43.53,Default,,0,0,0,,Hatta yeni tanıştığımız zamanlarda\N‎ona çok kötü davrandım.
Dialogue: 0,0:20:44.53,0:20:45.54,Default,,0,0,0,,{\an8}‎O benim arkadaşım.
Dialogue: 0,0:20:46.50,0:20:47.58,Default,,0,0,0,,{\an8}‎Yani onu seviyorum.
Dialogue: 0,0:20:48.75,0:20:52.79,Default,,0,0,0,,Onun bunu söylediğini duymak\N‎benim için yeterli.
Dialogue: 0,0:20:53.71,0:20:58.22,Default,,0,0,0,,Hatta belki ona karşı olan duygularım da\N‎o kadar gerçek değildir.
Dialogue: 0,0:20:59.42,0:21:02.09,Default,,0,0,0,,Genellikle ben reddeden taraf olurum.
Dialogue: 0,0:21:02.09,0:21:03.35,Default,,0,0,0,,Yani ben…
Dialogue: 0,0:21:04.64,0:21:06.56,Default,,0,0,0,,Kendimi yalnız hissettim sanırım.
Dialogue: 0,0:21:08.23,0:21:10.81,Default,,0,0,0,,Eğer öyleyse artık iyiyim.
Dialogue: 0,0:21:11.52,0:21:14.61,Default,,0,0,0,,Şu anki durumla yetinmeyi bilirsem\N‎yalnızlık hissetmem.
Dialogue: 0,0:21:16.36,0:21:17.73,Default,,0,0,0,,Kendimi zorlayarak
Dialogue: 0,0:21:19.11,0:21:20.57,Default,,0,0,0,,eski duygularıma dönebilirim.
Dialogue: 0,0:21:22.57,0:21:23.70,Default,,0,0,0,,‎Günaydın.
Dialogue: 0,0:21:25.58,0:21:26.78,Default,,0,0,0,,‎Günaydın.
Dialogue: 0,0:21:26.79,0:21:27.87,Default,,0,0,0,,{\pos(193.2,95.933)}‎SINIF 2 ŞUBE 2
Dialogue: 0,0:21:27.87,0:21:30.71,Default,,0,0,0,,‎Neler oluyor? Bugün erkencisin Miki.
Dialogue: 0,0:21:32.12,0:21:33.13,Default,,0,0,0,,‎Minato! Günaydın!
Dialogue: 0,0:21:35.13,0:21:36.21,Default,,0,0,0,,‎Günaydın Koyun!
Dialogue: 0,0:21:36.21,0:21:37.46,Default,,0,0,0,,‎Günaydın.
Dialogue: 0,0:21:41.38,0:21:42.59,Default,,0,0,0,,‎Günaydın Yota!
Dialogue: 0,0:21:47.89,0:21:49.98,Default,,0,0,0,,‎Ne kadar enerjiksin. Günaydın.
Dialogue: 0,0:23:39.29,0:23:40.92,Default,,0,0,0,,Bu gidişle,
Dialogue: 0,0:23:40.92,0:23:42.67,Default,,0,0,0,,bu duygularım
Dialogue: 0,0:23:43.76,0:23:46.80,Default,,0,0,0,,sadece kötü bir şaka gibi algılanacak.
Dialogue: 0,0:23:48.09,0:23:51.81,Default,,0,0,0,,Ona böyle davranmaya devam edersem
Dialogue: 0,0:23:53.27,0:23:54.72,Default,,0,0,0,,bana nasıl âşık olabilir?
Dialogue: 0,0:23:54.72,0:23:56.73,Default,,0,0,0,,‎Alt yazı çevirmeni: Hayrullah Doğan
Dialogue: 0,0:00:00.00,0:00:05.00,Default,,0,0,0,,
